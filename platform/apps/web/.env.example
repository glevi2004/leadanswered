# --- Supabase Auth (from your Supabase project → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...        # the "anon public" key
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # server-only; for inviting contractors (keep secret)

# --- Who is the platform admin (you) — comma-separated emails ---
ADMIN_EMAILS=levigabrielcramos@gmail.com

# --- Postgres (same Supabase DB as the api) ---
# Local dev: session pooler (5432) is fine. On Vercel: use the TRANSACTION pooler (6543).
DB_PASSWORD=your-db-password
DATABASE_URL=postgresql://postgres.<project-ref>:${DB_PASSWORD}@<pooler-host>:5432/postgres
