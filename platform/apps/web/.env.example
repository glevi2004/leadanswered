# --- Supabase Auth (from your Supabase project → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...        # the "anon public" key
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # server-only; for inviting contractors (keep secret)

# --- Who is the platform admin (you) — comma-separated emails ---
ADMIN_EMAILS=levigabrielcramos@gmail.com

# --- Public site URL — used server-side for invite/reset email redirect links ---
# Local dev: http://localhost:3002. In production: https://app.leadanswered.com
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Note: the web app talks to the DB via supabase-js (service-role key above), NOT Prisma,
# so it needs no DATABASE_URL.

# Google Calendar connect handoff (must match apps/api). See GOOGLE_CALENDAR.md.
API_PUBLIC_URL=
CALENDAR_STATE_SECRET=
