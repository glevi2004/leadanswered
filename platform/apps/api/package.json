{
  "name": "@leadanswered/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "exports": {
    ".": "./src/server.ts",
    "./worker": "./src/worker.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/scripts/seedDb.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.86",
    "@langfuse/otel": "^5.6.0",
    "@leadanswered/core": "workspace:*",
    "@leadanswered/db": "workspace:*",
    "@opentelemetry/sdk-node": "^0.219.0",
    "ai": "^6.0.209",
    "bullmq": "^5.79.1",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "express": "^5.2.1",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
