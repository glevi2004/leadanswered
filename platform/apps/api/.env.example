# --- AI provider (provider-agnostic via the Vercel AI SDK) ---
# AI_PROVIDER defaults to "anthropic"; AI_MODEL defaults to claude-haiku-4-5.
# Only the selected provider's key is required. OpenAI is swap-ready (install @ai-sdk/openai).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# AI_PROVIDER=anthropic
# AI_MODEL=claude-haiku-4-5
# OPENAI_API_KEY=sk-...

# --- API server ---
PORT=3000

# --- Background worker (optional) ---
# When set, the quiet-lead nudge is scheduled to Redis and run by apps/worker.
# Unset → nudges are disabled (no-op); everything else works.
# REDIS_URL=redis://localhost:6379

# --- Email-parse lead intake (Postmark inbound — SCOPE §9) ---
# Lead emails arrive at leads+{slug}@<LEAD_EMAIL_DOMAIN>. Postmark's inbound webhook
# POSTs to /webhooks/email/postmark/<POSTMARK_INBOUND_SECRET>. Set the secret to enable.
# LEAD_EMAIL_DOMAIN=leads.leadanswered.com
# POSTMARK_INBOUND_SECRET=choose-a-long-random-string
# POSTMARK_SERVER_TOKEN=   # optional: send contractor email notifications via Postmark

# --- Observability (optional) ---
# Set both keys to trace every agent turn + tool call in Langfuse.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com   # region/self-host host (defaults to US cloud)

# --- Postgres (optional) ---
# When unset, the API runs in demo mode with an in-memory store (data not persisted)
# and a seeded test contractor. Set it to persist via Prisma/Postgres.
# On Supabase, use the session pooler (port 5432) — it works for both the app and
# `prisma migrate`. The transaction pooler (port 6543) is a later scaling upgrade.
# The password is kept in DB_PASSWORD and interpolated into DATABASE_URL via
# dotenv-expand (URL-encode special chars in DB_PASSWORD if any).
# DB_PASSWORD=your-db-password
# DATABASE_URL=postgresql://postgres.<project-ref>:${DB_PASSWORD}@<pooler-host>:5432/postgres

# --- Twilio (optional) ---
# When unset, Sarah's outbound messages are logged to the console instead of sent.
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx

# --- Dev/test (optional) ---
# Let an inbound SMS from an unknown number auto-start a conversation, so you can
# just text the Twilio number and have Sarah answer (off by default).
# ALLOW_INBOUND_LEADS=true
