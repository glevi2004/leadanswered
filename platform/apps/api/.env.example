# --- Anthropic (required) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Override the Claude model if you want (defaults to claude-haiku-4-5).
# CLAUDE_MODEL=claude-haiku-4-5

# --- API server ---
PORT=3000

# --- Postgres (optional) ---
# When unset, the API runs in demo mode with an in-memory store (data not persisted)
# and a seeded test contractor. Set it to persist via Prisma/Postgres.
# DATABASE_URL=postgresql://user:password@localhost:5432/leadanswered

# --- Twilio (optional) ---
# When unset, Sarah's outbound messages are logged to the console instead of sent.
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
