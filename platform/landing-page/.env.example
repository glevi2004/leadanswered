# Analytics — set these in Vercel → Project → Settings → Environment Variables, then
# redeploy. The analytics + consent-banner system stays OFF until at least one is set,
# so the site ships clean until you're ready.

# ── ACTIVE SETUP: PostHog only ────────────────────────────────────────────────
# PostHog covers behavior + which pages + geo + session replay + heatmaps + A/B tests,
# all in one tool. Loads only after the visitor accepts the consent banner.
PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com   # or https://eu.i.posthog.com

# ── OPTIONAL / not currently used ─────────────────────────────────────────────
# The code also supports these if you ever want the Google stack. Leave blank.
# PUBLIC_GTM_ID=GTM-XXXXXXX      # Google Tag Manager (GA4/Clarity added as tags inside GTM)
# PUBLIC_GA4_ID=G-XXXXXXXXXX     # Google Analytics 4 direct (only when GTM is unset)
# PUBLIC_CLARITY_ID=xxxxxxxxxx   # Microsoft Clarity direct (only when GTM is unset)
