---
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  tags?: string[];
  ogImage?: string;
}
const {
  title,
  description,
  pubDate,
  updatedDate,
  author = "Levi Ramos",
  tags = [],
  ogImage,
} = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const blogPosting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { "@type": "Person", name: author },
  publisher: {
    "@type": "Organization",
    name: "Lead Answered",
    logo: {
      "@type": "ImageObject",
      url: "https://leadanswered.com/logo.png",
    },
  },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Base
  title={`${title} — Lead Answered`}
  description={description}
  image={ogImage ?? "/og.png"}
  ogType="article"
  jsonLd={blogPosting}
>
  <Nav />
  <article class="max-w-[720px] mx-auto px-6 py-16">
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 text-[13px] font-medium text-ink-400 hover:text-brand-600 transition"
    >
      ← All posts
    </a>

    <h1 class="section-h text-[32px] md:text-[44px] text-ink-900 mt-5 mb-3">
      {title}
    </h1>

    <div class="flex flex-wrap items-center gap-2 text-[14px] text-ink-400 mb-10">
      <span class="font-medium text-ink-500">{author}</span>
      <span>·</span>
      <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
      {
        tags[0] && (
          <>
            <span>·</span>
            <span class="text-brand-600 font-medium">{tags[0]}</span>
          </>
        )
      }
    </div>

    <div
      class="prose prose-slate max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-ink-900 prose-h2:text-[24px] prose-h2:mt-10 prose-a:text-brand-600 prose-a:font-medium prose-a:no-underline hover:prose-a:underline prose-strong:text-ink-900 prose-li:my-1"
    >
      <slot />
    </div>

    <!-- End-of-post CTA -->
    <div
      class="mt-14 rounded-2xl bg-paper-100 border border-black/[0.06] p-7 text-center"
    >
      <h3 class="section-h text-[22px] md:text-[26px] text-ink-900 mb-2">
        We're taking on 3 design partners.
      </h3>
      <p class="text-[15px] text-ink-500 max-w-[440px] mx-auto mb-5">
        We build your operating system with you, free, you run it by text, and you
        decide later. Zero reason to say no.
      </p>
      <a href="https://cal.com/leviramos" class="btn-primary btn-primary-lg">
        Become a design partner
        <svg
          class="arrow w-4 h-4"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M3 8h10m0 0L9 4m4 4l-4 4"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>
  </article>
  <Footer />
</Base>
