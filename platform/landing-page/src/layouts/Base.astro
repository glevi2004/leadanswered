---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
}
const {
  title,
  description,
  image = "/og.png",
  ogType = "website",
  noindex = false,
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(image, Astro.site).href;

// Sitewide Organization entity; page-specific entities are merged in via `jsonLd`.
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "KiwiOS",
  url: "https://leadanswered.com",
  logo: "https://leadanswered.com/logo.png",
  email: "levi@leadanswered.com",
  description:
    "The AI operating system for service businesses — website, leads, quotes, scheduling, reviews, and invoicing, run by texting one assistant. Built with you as a design partner.",
};
const structured = [
  organization,
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];

// Analytics (PostHog — see ANALYTICS-PLAN.md). Dormant until PUBLIC_POSTHOG_KEY is set in env.
const POSTHOG_KEY = import.meta.env.PUBLIC_POSTHOG_KEY;
const analyticsOn = Boolean(POSTHOG_KEY);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/kiwi.png?v=3" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="KiwiOS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(structured)} />

    <script>
      // Load the consent banner + PostHog runtime only when configured (PUBLIC_POSTHOG_KEY set).
      if (import.meta.env.PUBLIC_POSTHOG_KEY) {
        import("../scripts/analytics-client.ts");
      }
    </script>

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
