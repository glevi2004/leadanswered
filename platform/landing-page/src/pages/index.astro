---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { trades } from "../data/trades";

const softwareApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Lead Answered",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web, iOS, Android",
  url: "https://leadanswered.com",
  description:
    "The AI operating system for service businesses — website, leads, quotes, scheduling, reviews, and invoicing, run by texting one assistant. Built with you as a design partner.",
};

const faqs = [
  { q: "Do I have to leave my current software?", a: "No. You keep everything until Sarah's better. We import your history, stand up the new tools alongside what you have, and you switch when you're ready — not before." },
  { q: "What if I already have a website?", a: "We can build you a new one (so nothing depends on your old developer) or connect Sarah to your current site. Your call." },
  { q: "What happens after the free period?", a: "Once you're relying on it and you've seen the ROI, we agree on fair founder pricing. If it's not worth it, you walk away — no contract, no lock-in." },
  { q: "How long does setup take?", a: "The first pieces — your site and the review campaign — go live in days. We build out the rest with you over about six weeks." },
  { q: "Why only 3 partners?", a: "Because we build it with you, hands-on. Three at a time is how we keep it that close." },
  { q: "Is it an app, or just texting?", a: "Both. There's a full app, set up for you — and you can also just text Sarah for the day-to-day. They work together." },
];
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};

// Radial hub nodes (component B). Positions computed on a circle.
const hubNodes = [
  { label: "Website", d: "M12 3a9 9 0 100 18 9 9 0 000-18M3 12h18M12 3c2.4 2.6 2.4 15.4 0 18M12 3c-2.4 2.6-2.4 15.4 0 18" },
  { label: "SEO & AI search", d: "M11 18a7 7 0 100-14 7 7 0 000 14zM20 20l-4-4" },
  { label: "Blog posts & Socials", d: "M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8zM14 3v5h5M9 13h6M9 17h4" },
  { label: "Lead response", d: "M21 12a8 8 0 01-11.5 7.2L3 21l1.8-6.5A8 8 0 1121 12z" },
  { label: "Quoting & Invoicing", d: "M6 2h12a1 1 0 011 1v18l-3-2-3 2-3-2-3 2V3a1 1 0 011-1zM9 7h6M9 11h6" },
  { label: "Scheduling", d: "M8 2v3M16 2v3M3.5 8.5h17M5 4.5h14a1 1 0 011 1v13a1 1 0 01-1 1H5a1 1 0 01-1-1v-13a1 1 0 011-1z" },
  { label: "Reviews", d: "M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17.8 6.6 20l1-6.1L3.2 9.5l6.1-.9z" },
  { label: "CRM", d: "M16 20v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2M9 10a4 4 0 100-8 4 4 0 000 8zM22 20v-2a4 4 0 00-3-3.9M16 2.1a4 4 0 010 7.8" },
];
const R = 40;
const hub = hubNodes.map((n, i) => {
  const a = (i / hubNodes.length) * 2 * Math.PI - Math.PI / 2;
  return { ...n, x: 50 + R * Math.cos(a), y: 50 + R * Math.sin(a) };
});

// Day-one ROI: the "get found" trio, rendered as isometric mini-orbs (Sarah-cube style).
const roiOrbs = [
  { label: "Website", d: "M12 3a9 9 0 100 18 9 9 0 000-18M3 12h18M12 3c2.4 2.6 2.4 15.4 0 18M12 3c-2.4 2.6-2.4 15.4 0 18", fill: false },
  { label: "SEO", d: "M11 18a7 7 0 100-14 7 7 0 000 14zM20 20l-4-4", fill: false },
  { label: "ChatGPT", d: "M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.677l5.814 3.354-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855-5.843-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zM8.307 12.863l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.376-3.454l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365 2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z", fill: true },
];
---

<Base
  title="Lead Answered — The AI operating system for service businesses."
  description="Run your business by texting one assistant — website, leads, quotes, scheduling, reviews, invoicing, and more. We build it with you, free, as a design partner."
  jsonLd={[softwareApp, faqLd]}
>
  <Nav />

  <!-- ============ HERO ============ -->
  <section data-section="hero" class="hero-bg pt-14 pb-16 md:pt-20 md:pb-24 relative overflow-hidden">
    <div class="hero-radial absolute inset-0"></div>
    <div class="relative max-w-3xl mx-auto px-5 text-center">
      <div class="pill mb-5 animate-fade-in">
        <span class="relative flex h-1.5 w-1.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-500 opacity-60"></span>
          <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-brand-500"></span>
        </span>
        Now selecting 3 design partners
      </div>
      <h1 class="display text-[38px] sm:text-[44px] md:text-[50px] lg:text-[54px] text-ink-900 mb-4 animate-fade-in-up">
        The AI operating system for<br />
        <span class="serif-accent text-brand-600 block sm:inline text-[30px] sm:text-[36px] md:text-[40px] lg:text-[44px]">service businesses.</span>
      </h1>
      <p class="text-[16px] md:text-[18px] leading-[1.55] text-ink-500 max-w-[600px] mx-auto mb-8 animate-fade-in-up" style="animation-delay: 0.08s">
        Your website, leads, quotes, scheduling, reviews, invoicing — and more, handled by texting
        Sarah or in an app we set up for you. We build it with you, free, as a design partner.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-2.5 mb-8 animate-fade-in-up" style="animation-delay: 0.16s">
        <a href="https://cal.com/leviramos" class="btn-primary btn-primary-lg" data-track="cta_click" data-cta-location="hero" data-cta-text="Become a design partner">
          Become a design partner
          <svg class="arrow w-4 h-4" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a href="#demo" class="btn-secondary btn-secondary-lg" data-track="cta_click" data-cta-location="hero_secondary" data-cta-text="See Sarah in action">See Sarah in action</a>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[12.5px] text-ink-500 animate-fade-in" style="animation-delay: 0.32s">
        <div class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg><span>Built for you</span></div>
        <div class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg><span>No cost to start</span></div>
        <div class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg><span>A partner, not a customer</span></div>
      </div>
    </div>
  </section>

  {/* ============ VIDEO (component A) — hidden until the real demo video is ready ============
  <section class="relative bg-white">
    <div class="absolute inset-x-0 top-0 h-3/4 pointer-events-none" style="background: radial-gradient(60% 90% at 50% 0%, rgba(75,224,106,0.16), rgba(255,255,255,0) 72%);"></div>
    <div class="relative max-w-4xl mx-auto px-5 -mt-6 md:-mt-14 pb-16 md:pb-20">
      <div class="rounded-[1.75rem] bg-ink-900 p-2 shadow-[0_40px_90px_-30px_rgba(16,24,40,0.45)]">
        <!-- Drop the real video here: replace this placeholder with
             <video src="/sarah-demo.mp4" poster="/video-poster.jpg" controls playsinline class="w-full h-full object-cover"></video> -->
        <div class="relative rounded-[1.4rem] overflow-hidden aspect-video bg-gradient-to-br from-ink-900 via-[#123720] to-[#0c2417]">
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-3">
            <span class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-white/95 flex items-center justify-center shadow-lg">
              <svg class="w-7 h-7 md:w-8 md:h-8 text-ink-900 ml-1" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
            </span>
            <span class="text-[13px] font-medium text-white/70">Watch the 2-minute demo</span>
          </div>
        </div>
      </div>
    </div>
  </section>
  */}

  <!-- ============ THE INSIGHT ============ -->
  <section class="py-20 md:py-24 soft-bg">
    <div class="max-w-3xl mx-auto px-5 text-center reveal">
      <p class="text-[12px] uppercase tracking-[0.18em] text-brand-600 font-semibold mb-3">The problem was never features</p>
      <h2 class="section-h text-[30px] md:text-[44px] text-ink-900 mb-6">You don't need more software. You need software you'll actually use.</h2>
      <div class="text-[16px] md:text-[17px] text-ink-500 leading-[1.65] space-y-4 text-left max-w-[640px] mx-auto">
        <p>Jobber, Housecall Pro, QuoteIQ — the tools already have the features. But they take weeks to set up, nobody ever configures the automations, and none of them were built for AI. So you pay every month for software you barely open, and you run the real business off your phone, your memory, and a notepad on the dash.</p>
        <p>Lead Answered is the opposite. One assistant that already knows your business, does the work the moment you ask, and comes set up — because we set it up for you.</p>
      </div>
    </div>
  </section>

  <!-- ============ MEET SARAH (component D — compact chat beside text) ============ -->
  <section id="demo" data-section="meet_sarah" class="py-20 md:py-24 bg-white scroll-mt-20">
    <div class="max-w-6xl mx-auto px-5">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <!-- Chat side -->
        <div class="reveal order-2 lg:order-1">
          <div class="flex justify-center lg:justify-start mb-4">
            <div class="inline-flex items-center gap-1 p-1 rounded-full bg-paper-100 border border-black/[0.06] text-[12.5px] font-medium">
              <button class="demo-tab px-3.5 py-1.5 rounded-full transition" data-mode="ops">You, running things</button>
              <button class="demo-tab px-3.5 py-1.5 rounded-full transition" data-mode="lead">Sarah, answering leads</button>
            </div>
          </div>
          <div class="imsg-screen max-w-[430px] mx-auto lg:mx-0 rounded-2xl bg-white border border-black/[0.08] overflow-hidden shadow-[0_24px_60px_-24px_rgba(16,24,40,0.28)]">
            <div class="flex items-center gap-2.5 px-4 py-3 border-b border-black/[0.06] bg-paper-100">
              <div id="demo-avatar" class="w-7 h-7 rounded-full bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center text-white text-[11px] font-semibold">S</div>
              <span id="demo-name" class="text-[13.5px] font-semibold text-ink-900">Sarah</span>
              <span class="ml-auto inline-flex items-center gap-1.5 text-[11px] font-medium text-ink-400">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span> Live
              </span>
            </div>
            <div id="chat-stream" class="px-4 py-4 space-y-2 h-[360px] overflow-hidden bg-white"></div>
            <div class="flex items-center gap-2 px-3 py-2.5 border-t border-black/[0.06]">
              <div class="flex-1 rounded-full border border-black/10 px-3.5 py-2 text-[12.5px] text-ink-400">Message Sarah…</div>
              <span class="w-8 h-8 rounded-full bg-brand-500 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-white" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </div>
          </div>
          <div class="text-center lg:text-left mt-3">
            <button id="replay-btn" class="text-[12px] text-ink-400 hover:text-brand-600 transition inline-flex items-center gap-1.5 font-medium">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-linecap="round" stroke-linejoin="round" /></svg>
              Replay
            </button>
          </div>
        </div>

        <!-- Text side -->
        <div class="reveal order-1 lg:order-2 text-center lg:text-left">
          <p class="text-[12px] uppercase tracking-[0.18em] text-brand-600 font-semibold mb-3">Meet Sarah</p>
          <h2 class="section-h text-[30px] md:text-[44px] text-ink-900 mb-4">Text Sarah. She handles it.</h2>
          <p class="text-[16px] md:text-[17px] text-ink-500 leading-[1.6] max-w-[520px] mx-auto lg:mx-0">
            Sarah is your AI assistant — by text or in the app. You text her to handle quotes,
            scheduling, invoicing, reviews, blog posts, and more. It's all in the app too, set up for
            you — but for the day-to-day, you just ask. She can also text your customers back,
            answering leads and booking jobs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHAT SARAH DOES (hub B + cards C) ============ -->
  <section id="how" data-section="hub" class="py-20 md:py-24 soft-bg scroll-mt-20">
    <div class="max-w-6xl mx-auto px-5">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-6 items-center mb-16 md:mb-20">
        <!-- text, left -->
        <div class="reveal text-center lg:text-left max-w-[560px] mx-auto lg:mx-0 lg:pr-6">
          <p class="text-[12px] uppercase tracking-[0.18em] text-brand-600 font-semibold mb-3">What Sarah does</p>
          <h2 class="section-h text-gradient-ink text-[30px] md:text-[42px] leading-[1.08]">Everything runs through Sarah.</h2>
          <p class="text-[15px] md:text-[17px] text-ink-500 mt-4 mb-7 leading-[1.6]">
            One assistant, set up for you — and we add more as we go.
          </p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3.5 text-left">
            {hub.map((n) => (
              <li class="flex items-center gap-2.5">
                <span class="flex h-5 w-5 flex-none items-center justify-center rounded-full bg-brand-400/15 text-brand-700">
                  <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
                <span class="text-[15px] md:text-[15.5px] font-medium text-ink-800">{n.label}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Radial hub (component B), right -->
        <div class="reveal">
        <!-- radial orbit (icons-only on mobile; labels shown on sm+) -->
        <div class="relative mx-auto aspect-square max-w-[320px] sm:max-w-[560px]">
          <svg viewBox="0 0 100 100" class="absolute inset-0 w-full h-full" fill="none" aria-hidden="true">
            {hub.map((n) => (<line x1={n.x} y1={n.y} x2="50" y2="50" stroke="rgba(16,24,40,0.07)" stroke-width="0.28" />))}
            {hub.map((n, i) => (<line x1={n.x} y1={n.y} x2="50" y2="50" stroke="#30d158" stroke-width="0.7" stroke-linecap="round" class="hub-pulse" style={`animation-delay:${(i * 0.45).toFixed(2)}s`} />))}
          </svg>
          <!-- compact inner platform: rings tucked near the center -->
          <div class="absolute inset-[30%] rounded-full border border-black/[0.05]"></div>
          <div class="absolute inset-[36%] rounded-full bg-white shadow-[0_12px_30px_-10px_rgba(16,24,40,0.18)]"></div>
          <!-- ring pulse: ripples out after the line sequence -->
          <div class="hub-ring-pulse absolute left-1/2 top-1/2 h-[76px] w-[76px] -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-brand-400/50"></div>
          <!-- center Sarah: real 3D isometric stacked tile (didit-style) -->
          <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col items-center">
            <div class="relative flex h-[116px] w-[116px] items-center justify-center">
              <div class="absolute inset-2 rounded-full bg-brand-400/35 blur-2xl"></div>
              <div class="absolute bottom-[22px] left-1/2 h-3 w-[70px] -translate-x-1/2 rounded-full bg-ink-900/20 blur-md"></div>
              <div class="sarah-iso">
                <div class="sarah-iso-inner">
                  <div class="sarah-slab" style="background:linear-gradient(135deg,#178036,#0f5f28);transform:translateZ(-13px)"></div>
                  <div class="sarah-slab" style="background:linear-gradient(135deg,#22b94a,#178036);transform:translateZ(-1px)"></div>
                  <div class="sarah-slab sarah-slab-top" style="background:linear-gradient(135deg,#7cef96,#2fce56);transform:translateZ(13px)"></div>
                </div>
              </div>
              <svg class="pointer-events-none absolute left-1/2 top-1/2 h-8 w-8 text-white drop-shadow-[0_1px_1.5px_rgba(6,46,20,0.35)]" style="transform:translate(-50%,-50%) translateY(-9px)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
            <span class="mt-1 text-[13.5px] font-semibold text-ink-900">Sarah</span>
          </div>
          <!-- nodes -->
          {hub.map((n) => (
            <div class="absolute -translate-x-1/2 -translate-y-1/2 flex flex-col items-center gap-1.5 w-9 sm:w-[92px]" style={`left:${n.x}%; top:${n.y}%`}>
              <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white border border-black/[0.08] shadow-card flex items-center justify-center">
                <svg class="w-4 h-4 sm:w-[18px] sm:h-[18px] text-ink-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d={n.d} stroke-linecap="round" stroke-linejoin="round" /></svg>
              </div>
              <span class="hidden sm:block text-[11px] font-medium text-ink-500 text-center leading-tight">{n.label}</span>
            </div>
          ))}
        </div>
        </div>
      </div>

      <!-- Feature cards with mini-UIs (component C) -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 reveal">
        <!-- Leads -->
        <div class="card card-hover p-6 flex flex-col">
          <h3 class="text-[17px] font-semibold text-ink-900 mb-1.5">Answers your leads</h3>
          <p class="text-[13.5px] text-ink-500 leading-[1.5] mb-5">A real text back in 60 seconds — day, night, busy season.</p>
          <div class="mt-auto rounded-xl bg-paper-100 border border-black/[0.05] p-3.5 space-y-1.5">
            <div class="flex justify-start"><span class="rounded-2xl bg-[#e9e9eb] text-ink-800 text-[12px] leading-snug px-3 py-1.5 max-w-[85%]">New lead — leak after the storm</span></div>
            <div class="flex justify-end"><span class="rounded-2xl bg-[#34c759] text-white text-[12px] leading-snug px-3 py-1.5 max-w-[85%]">On it — what's the address?</span></div>
            <div class="flex justify-end pt-0.5"><span class="inline-flex items-center gap-1 text-[10px] font-semibold text-brand-700"><span class="w-1 h-1 rounded-full bg-brand-500"></span>Replied in 57s</span></div>
          </div>
        </div>
        <!-- Quotes -->
        <div class="card card-hover p-6 flex flex-col">
          <h3 class="text-[17px] font-semibold text-ink-900 mb-1.5">Drafts your quotes</h3>
          <p class="text-[13.5px] text-ink-500 leading-[1.5] mb-5">Text her the job; she drafts and sends the quote.</p>
          <div class="mt-auto rounded-xl bg-paper-100 border border-black/[0.05] p-3.5">
            <div class="rounded-lg bg-white border border-black/[0.06] p-3">
              <div class="flex items-center justify-between mb-1.5">
                <span class="text-[11px] text-ink-400 font-medium">Quote · Miller roof</span>
                <span class="text-[10px] font-semibold text-brand-700 bg-brand-50 rounded-full px-1.5 py-0.5">Sent ✓</span>
              </div>
              <div class="text-[22px] font-bold text-ink-900 tracking-tight leading-none">$14,200</div>
              <div class="text-[11px] text-ink-400 mt-1">Full replacement · architectural shingles</div>
            </div>
          </div>
        </div>
        <!-- Reviews -->
        <div class="card card-hover p-6 flex flex-col">
          <h3 class="text-[17px] font-semibold text-ink-900 mb-1.5">Gets you reviews</h3>
