                <div class="flex justify-end"><span class="max-w-[82%] rounded-2xl rounded-br-md bg-brand-500 px-3 py-2 text-[12.5px] leading-snug text-white">On it — booked for 9am ✓</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <style is:global>
    /* one pulse travels down a single connector at a time; delays stagger them around the circle */
    @keyframes hub-pulse {
      0%   { stroke-dashoffset: 0;   opacity: 0; }
      2%   { opacity: 1; }
      9%   { stroke-dashoffset: -40; }
      12%  { opacity: 0; }
      100% { stroke-dashoffset: -40; opacity: 0; }
    }
    .hub-pulse { stroke-dasharray: 5 70; stroke-dashoffset: 0; opacity: 0; animation: hub-pulse 6s linear infinite; }
    /* after the lines finish their loop, a ring ripples out from Sarah */
    @keyframes hub-ring-pulse {
      0%, 80% { transform: translate(-50%, -50%) scale(0.55); opacity: 0; }
      84%     { opacity: 0.5; }
      100%    { transform: translate(-50%, -50%) scale(4); opacity: 0; }
    }
    .hub-ring-pulse { opacity: 0; animation: hub-ring-pulse 6s ease-out infinite; }
    /* 3D isometric Sarah tile (didit-style layered cube) */
    .sarah-iso { position: relative; width: 66px; height: 66px; perspective: 820px; }
    .sarah-iso-inner { position: absolute; inset: 0; transform-style: preserve-3d; transform: rotateX(55deg) rotateZ(-45deg); }
    .sarah-slab { position: absolute; inset: 0; border-radius: 18px; }
    .sarah-slab-top { display: flex; align-items: center; justify-content: center; box-shadow: inset 0 2px 1px rgba(255, 255, 255, 0.5); }
    /* smaller isometric orbs (day-one ROI "get found" trio + reviews outcome) */
    .iso-orb { position: relative; width: 46px; height: 46px; perspective: 620px; }
    .iso-orb-inner { position: absolute; inset: 0; transform-style: preserve-3d; transform: rotateX(55deg) rotateZ(-45deg); }
    .iso-orb-slab { position: absolute; inset: 0; border-radius: 13px; }
    .iso-orb-top { box-shadow: inset 0 1.5px 1px rgba(255, 255, 255, 0.5); }
    @keyframes roi-drop {
      0% { transform: translate(-50%, 0); opacity: 0; }
      18% { opacity: 1; }
      82% { opacity: 1; }
      100% { transform: translate(-50%, 34px); opacity: 0; }
    }
    .roi-drop { transform: translate(-50%, 0); animation: roi-drop 2.4s ease-in-out infinite; }
    @media (prefers-reduced-motion: reduce) { .roi-drop { animation: none; } }
    @media (prefers-reduced-motion: reduce) {
      .hub-pulse, .hub-ring-pulse { animation: none; }
    }
    /* FAQ accordion (didit-style smooth expand) */
    .faq-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.32s ease; }
    .faq-panel > div { min-height: 0; overflow: hidden; }
    .faq-item.open .faq-panel { grid-template-rows: 1fr; }
    .faq-item.open .faq-chevron { transform: rotate(180deg); }
    @media (prefers-reduced-motion: reduce) { .faq-panel { transition: none; } }
  </style>

  <script>
    import { track } from "../lib/analytics";

    // Scroll reveal
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add("visible"); io.unobserve(entry.target); } });
    }, { threshold: 0.12 });
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

    // ===== iMessage demo (two modes) =====
    const convos = {
      ops: {
        name: "Sarah", initials: "S",
        messages: [
          { from: "me", html: "Generate a quote for the Miller roof — full replacement, architectural shingles", delay: 1000 },
          { from: "them", html: "Done ✅ <u>$14,200</u> quote drafted and texted to the Millers to approve.", delay: 1500 },
          { from: "me", html: "What's on the schedule Thursday?", delay: 950 },
          { from: "them", html: "3 estimates —\n<u>9:00 · Newton</u>\n<u>11:30 · Brookline</u>\n<u>2:00 · Waltham</u>\nRouted shortest-drive — you've got a 40-min gap at 1.", delay: 1800 },
          { from: "me", html: "Just wrapped the Miller job — here are a few photos 📸 Text them for a review and write a blog post about it", delay: 1250 },
          { from: "them", html: "Done ✅ Review request sent to the Millers. Blog post drafted with your photos — want it live on the site and posted to Facebook?", delay: 1900 },
          { from: "me", html: "Yes, both", delay: 900 },
          { from: "them", html: "Published and posted — links on the way. 📈", delay: 1400 },
        ],
      },
      lead: {
        name: "Apex Roofing", initials: "AR",
        messages: [
          { from: "them", html: "Hi Levi, this is Sarah with Apex Roofing 👋 Thanks for reaching out — are you looking to repair a leak, or replace the roof?", delay: 1500 },
          { from: "me", html: "Repair — got a leak after the storm", delay: 1000 },
          { from: "them", html: "Sorry to hear that, we can take care of it. What's the address so I can confirm you're in our area?", delay: 1500 },
          { from: "me", html: "24 Birch Lane, Boston", delay: 950 },
          { from: "them", html: "Perfect, you're covered. Here's what we have open for a free on-site estimate:\n<u>Wed, Jun 24 · 10:00 AM</u>\n<u>Thu, Jun 25 · 3:00 PM</u>\n<u>Mon, Jun 29 · 9:00 AM</u>\nWhich works best?", delay: 1800 },
          { from: "me", html: "The last one", delay: 950 },
          { from: "them", html: "You're all set for <u>Mon, Jun 29 at 9:00 AM</u>. We'll swing by <u>24 Birch Lane</u> to take a look. See you then, Levi! 🙌", delay: 1650 },
        ],
      },
    };

    let mode = "ops";
    let token = 0;
    let autoTimer = null;
    const wait = (ms) => new Promise((r) => setTimeout(r, ms));

    function bubble(from, html) {
      const wrap = document.createElement("div");
      wrap.className = `flex ${from === "me" ? "justify-end" : "justify-start"}`;
      const b = document.createElement("div");
      b.className = `msg ${from === "me" ? "msg-me" : "msg-them"} whitespace-pre-line`;
      b.innerHTML = html;
      wrap.appendChild(b);
      wrap.style.opacity = "0";
      wrap.style.transform = "translateY(6px)";
      wrap.style.transition = "opacity 0.35s ease, transform 0.35s ease";
      return wrap;
    }
    function typing() {
      const wrap = document.createElement("div");
      wrap.className = "flex justify-start";
      const b = document.createElement("div");
      b.className = "msg msg-them";
      b.style.padding = "10px 14px";
      b.innerHTML = '<span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>';
      wrap.appendChild(b);
      return wrap;
    }
    async function runDemo() {
      token++;
      const myToken = token;
      if (autoTimer) { clearTimeout(autoTimer); autoTimer = null; }
      const stream = document.getElementById("chat-stream");
      if (!stream) return;
      const convo = convos[mode];
      const nameEl = document.getElementById("demo-name");
      const avEl = document.getElementById("demo-avatar");
      if (nameEl) nameEl.textContent = convo.name;
      if (avEl) avEl.textContent = convo.initials;
      stream.innerHTML = "";
      for (const msg of convo.messages) {
        if (myToken !== token) return;
        if (msg.from === "them") {
          const t = typing();
          stream.appendChild(t);
          stream.scrollTop = stream.scrollHeight;
          await wait(msg.delay);
          if (myToken !== token) return;
          stream.removeChild(t);
        } else {
          await wait(msg.delay);
          if (myToken !== token) return;
        }
        const b = bubble(msg.from, msg.html);
        stream.appendChild(b);
        requestAnimationFrame(() => { b.style.opacity = "1"; b.style.transform = "translateY(0)"; });
        stream.scrollTop = stream.scrollHeight;
        await wait(340);
      }
      autoTimer = setTimeout(() => { if (myToken === token) runDemo(); }, 6500);
    }

    const tabs = document.querySelectorAll(".demo-tab");
    function setActive() {
      tabs.forEach((t) => {
        const on = t.dataset.mode === mode;
        t.classList.toggle("bg-white", on);
        t.classList.toggle("shadow-sm", on);
        t.classList.toggle("text-ink-900", on);
        t.classList.toggle("text-ink-400", !on);
      });
    }
    tabs.forEach((t) => t.addEventListener("click", () => { if (mode === t.dataset.mode) return; mode = t.dataset.mode; track("demo_interact", { action: "toggle_" + mode }); setActive(); runDemo(); }));
    setActive();
    runDemo();
    document.getElementById("replay-btn")?.addEventListener("click", () => { track("demo_interact", { action: "replay" }); runDemo(); });

    // FAQ accordion (single-open, smooth)
    document.querySelectorAll(".faq-q").forEach((btn) => {
      btn.addEventListener("click", () => {
        const item = btn.closest(".faq-item");
        const willOpen = !item.classList.contains("open");
        document.querySelectorAll(".faq-item.open").forEach((el) => {
          el.classList.remove("open");
          el.querySelector(".faq-q")?.setAttribute("aria-expanded", "false");
        });
        if (willOpen) {
          item.classList.add("open");
          btn.setAttribute("aria-expanded", "true");
          track("faq_open", { question: btn.querySelector("span")?.textContent?.trim() });
        }
      });
    });
  </script>
</Base>
