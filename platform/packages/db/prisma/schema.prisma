// Prisma schema for Lead Answered — Phase 1 data model (SCOPE §4).
// Vertical-neutral names: Organization is the tenant business (any service vertical).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NumberType {
  toll_free
  local
}

enum VerificationStatus {
  pending
  verified
  failed
}

enum NumberStatus {
  active
  pending_swap
  retired
}

// Waitlist (self-serve front door): people join → admin accepts → shell org + invite → onboarding.
enum WaitlistStatus {
  pending
  accepted
  declined
}

model Waitlist {
  id        String         @id @default(cuid())
  email     String         @unique
  name      String?
  company   String?
  note      String?        @db.Text
  status    WaitlistStatus @default(pending)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status])
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  companyName          String
  // Email-routing key (SCOPE §9): lead emails arrive at leads+{slug}@<domain>.
  slug                 String?  @unique
  projectTypes         String[]
  qualificationRules   Json     @default("{}")
  standingAvailability Json     @default("{}")
  sarahName            String   @default("Sarah")
  sarahPersonaNotes    String?
  // Customer-question topics Sarah loops the owner in on (dashboard-editable; SCOPE §5.1).
  escalationTopics     String[] @default([])

  // Onboarding (Phase 3): owner login link + whether they've finished self-serve setup.
  ownerEmail         String? @unique
  onboardingComplete Boolean @default(false)

  // Structured service area (SCOPE §5.1) — never free-text.
  baseLocations    Json     @default("[]") // [{ zip, radiusMiles }]
  includeOverrides String[] @default([])
  excludeOverrides String[] @default([])

  // Telephony (SCOPE §9.5) — dedicated number per organization.
  twilioNumber        String?
  messagingServiceSid String?
  numberType          NumberType         @default(toll_free)
  verificationStatus  VerificationStatus @default(pending)
  numberStatus        NumberStatus       @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Lu Computer — agent backend (ADDITIVE ONLY). Specs: AGENTS-BACKEND.md §2/§5a,
// CANVAS-TOOLS.md §1. Every model is org-scoped via a scalar `orgId` (no relation
// field onto the existing Organization model — keeps this block self-contained and
// RLS-safe). Cross-model references (agentId/taskId/refId/…) are indexed scalars;
// only the strong parent-child pairs (Agent→ContractRevision, Site→Deployment, and
// Task self-decomposition) carry Prisma relations.
// ─────────────────────────────────────────────────────────────────────────────

enum AgentStatus {
  idle
  working
}

enum DepartmentStatus {
  active // has a real, working agent (v0: Engineering only)
  in_development // visible on the canvas as a locked "In development" tile, no agent yet
}

enum TaskStatus {
  agent_can_do
  needs_input
  needs_earlier
  in_progress
  needs_approval
  done
  failed
}

enum ArtifactKind {
  agent_session
  pr_diff
  site_preview
  image
  file
  doc
}

enum SiteStatus {
  draft
  building
  preview
  live
  failed
}

enum DeploymentEnv {
  preview
  production
}

enum DeploymentStatus {
  queued
  building
  ready
  error
  canceled
}

enum SessionStatus {
  starting
  running
  hibernated
  killed
  failed
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum CanvasNodeType {
  terminal
  markdown
  folder
  site
  text
  drawing
  note
  file
  agent
}

enum EdgeKind {
  owns
  reads
  produces
  uses
}

/// A department (one of the 8) instantiated for an org. `active` replaces graph.ts's
/// hardcoded flag; `context` is the dept's facts + code-of-conduct slice (§2).
model Department {
  id        String   @id @default(cuid())
  orgId     String
  key       String // sales | operations | finance | legal | engineering | design | marketing | support
  status    DepartmentStatus @default(in_development)
  context   String   @default("") @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, key])
  @@index([orgId])
}

/// A hired agent. `contract` = its CONTRACT.md identity file (§5a); `models` holds its
/// reasoning + generation model ids (§5b). Default one per active dept + custom.
model Agent {
  id            String      @id @default(cuid())
  orgId         String
  departmentKey String
  name          String
  role          String
  contract      String      @default("") @db.Text
  models        Json        @default("{}")
  status        AgentStatus @default(idle)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  contractRevisions ContractRevision[]

  @@index([orgId])
  @@index([orgId, departmentKey])
}

/// Versioned history of an Agent.contract — diff / revert how its identity evolved (§5a).
model ContractRevision {
  id        String   @id @default(cuid())
  agentId   String
  content   String   @db.Text
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

/// A unit of work. Roadmap steps ARE tasks (ordering + needs_earlier). `parentTaskId`
/// = Lu's decomposition; `model` = per-task model override (§5b); `assignedBy` = lu|user.
model Task {
  id            String     @id @default(cuid())
  orgId         String
  departmentKey String
  agentId       String?
  title         String
  body          String     @db.Text
  status        TaskStatus @default(agent_can_do)
  parentTaskId  String?
  input         Json?
  result        Json?
  model         String?
  assignedBy    String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  parent   Task?  @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Task[] @relation("TaskSubtasks")

  @@index([orgId])
  @@index([orgId, departmentKey])
  @@index([agentId])
  @@index([parentTaskId])
}

/// An output produced by a task/agent. Powers the ArtifactsNav (browser = site_preview,
/// images, PR diff, agent_session = the interactive transcript) (§2).
model Artifact {
  id        String       @id @default(cuid())
  orgId     String
  taskId    String?
  agentId   String?
  kind      ArtifactKind
  title     String
  payload   Json         @default("{}")
  createdAt DateTime     @default(now())

  @@index([orgId])
  @@index([taskId])
  @@index([agentId])
}

/// A customer / dogfood website. Domain default = {slug}.lu.computer (§2/§7).
model Site {
  id              String     @id @default(cuid())
  orgId           String
  departmentKey   String?
  repoFullName    String?
  vercelProjectId String?
  domain          String?
  status          SiteStatus @default(draft)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  deployments Deployment[]

  @@index([orgId])
}

/// A preview / production deploy of a Site (§2/§6).
model Deployment {
  id        String           @id @default(cuid())
  siteId    String
  env       DeploymentEnv
  url       String
  sha       String?
  prNumber  Int?
  status    DeploymentStatus @default(queued)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

/// A sandbox / terminal coding session (CANVAS-TOOLS §4). `agentKind` = claude_code |
/// codex | shell; `transcript` streams into an agent_session Artifact.
model Session {
  id         String        @id @default(cuid())
  orgId      String
  sandboxId  String?
  agentKind  String
  repo       String?
  status     SessionStatus @default(starting)
  transcript String?       @db.Text
  // Agent-compute metering (plan Pillar 2): wall-clock the sandbox ran, for the usage bucket.
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([orgId])
}

/// GitHub App installation for an org — scoped clone/branch/PR tokens (§2/§6).
/// A per-org GitHub App installation (BYO) — the org's own GitHub the Engineer builds in.
/// `userToken` is the encrypted user-to-server OAuth token (repo creation); installation tokens
/// (repo ops) are minted on the fly from the App id + private key. See docs/byo-connect.md.
model GithubConnection {
  id             String   @id @default(cuid())
  orgId          String
  installationId String?
  login          String?
  repos          Json?
  userToken      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orgId])
}

/// A per-org Vercel connection (BYO) — the org's own Vercel account/team the Engineer deploys into.
/// `accessToken` is the encrypted Vercel OAuth access token. See docs/byo-connect.md.
model VercelConnection {
  id           String   @id @default(cuid())
  orgId        String
  accessToken  String
  teamId       String?
  vercelUserId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId])
}

/// A per-org Supabase connection (BYO) — the company's ONE shared, Engineering-anchored managed
/// Supabase project the console mirrors (docs/canvas.md §"the backend"; docs/byo-connect.md step 0).
/// `projectRef` = the project id (→ https://{ref}.supabase.co). `serviceKey` = the encrypted
/// project service_role key (project REST/auth/storage admin). `managementToken` = the encrypted
/// Supabase Management API token (PAT or OAuth) for project-level reads (config/migrations/advisors).
/// Secrets are brokered — never returned to the client. See docs/canvas.md.
model SupabaseConnection {
  id              String   @id @default(cuid())
  orgId           String
  projectRef      String
  serviceKey      String
  managementToken String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orgId])
}

/// Generalized human-in-the-loop gate (extends the SMS hard-gate). Feeds "Needs you" (§4).
model Approval {
  id        String         @id @default(cuid())
  orgId     String
  taskId    String?
  action    String
  status    ApprovalStatus @default(pending)
  decidedBy String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([orgId])
  @@index([taskId])
}

/// A user-created element on the canvas plane (CANVAS-TOOLS §1). `refId` is a soft FK
/// to the backing entity (Session / Artifact / Collection / Site / Note / Drawing).
model CanvasNode {
  id        String         @id @default(cuid())
  orgId     String
  type      CanvasNodeType
  x         Float
  y         Float
  w         Float?
  h         Float?
  refId     String?
  z         Int?
  createdBy String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([orgId])
}

/// A directed connection between canvas nodes / agents — owns | reads | produces
/// (CANVAS-TOOLS §1/§10). `fromId`/`toId` are soft FKs (Agent or CanvasNode).
model Edge {
  id        String   @id @default(cuid())
  orgId     String
  fromId    String
  toId      String
  kind      EdgeKind
  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([fromId])
  @@index([toId])
}

/// A folder / library — an agent's knowledge + asset store (CANVAS-TOOLS §6).
model Collection {
  id        String   @id @default(cuid())
  orgId     String
  agentId   String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([agentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Metering — "agent compute" usage bucket (plan Pillar 2). Every LLM call and
// sandbox run is metered per org; costMicros (USD millionths) comes from the core
// price table. Aggregated per period to enforce the bucket + bill overage.
// ─────────────────────────────────────────────────────────────────────────────

enum UsageKind {
  llm
  sandbox
}

/// One agent-compute meter event, org-scoped. `llm` rows carry token counts + model;
/// `sandbox` rows carry wall-clock seconds. `costMicros` = USD millionths (int, exact).
model UsageEvent {
  id             String    @id @default(cuid())
  orgId          String
  at             DateTime  @default(now())
  kind           UsageKind
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  sandboxSeconds Int?
  costMicros     Int       @default(0)
  taskId         String?
  agentId        String?

  @@index([orgId])
  @@index([orgId, at])
}

// ─────────────────────────────────────────────────────────────────────────────
// Memory — Tier 1: working memory (plan Pillar 3). The Lu conversation persisted
// server-side so Lu keeps context across sessions (today it is client-only + lost
// on reload). Tiers 2/3 (core + long-term Memory) build on this.
// ─────────────────────────────────────────────────────────────────────────────

/// A persisted Lu conversation thread (org-scoped). v0: one "main" thread per org.
model Thread {
  id        String    @id @default(cuid())
  orgId     String
  title     String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages  Message[]

  @@index([orgId])
}

/// One turn in a Thread. `role` = user | assistant. Ordered by createdAt.
/// `meta` marks system-authored report-back messages (docs/workflow.md §3) so the
/// UI can render them as event cards, not plain chat text.
model Message {
  id        String   @id @default(cuid())
  threadId  String
  orgId     String
  role      String
  content   String   @db.Text
  meta      Json?
  createdAt DateTime @default(now())

  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([orgId])
}

/// The event journal — the flow layer's spine (docs/workflow.md §1). Every notable
/// transition (dispatch, preview, verify, publish, failure, question) writes one row.
/// Feeds Lu's situational block (§2), the thread report-back (§3), and the UI's
/// derived chat states (§4).
model AgentEvent {
  id        String   @id @default(cuid())
  orgId     String
  taskId    String?
  kind      String
  message   String   @db.Text
  payload   Json?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([taskId])
}

enum MemoryTier {
  core
  longterm
}

/// Durable org knowledge Lu draws on (plan Pillar 3, Tiers 2/3). `core` = compact "what Lu knows
/// about you + how she has worked" injected into her system prompt every turn; `longterm` = durable
/// facts (roadmaps, prefs, integrations) retrieved as needed. `key` lets a fact be upserted in place;
/// `source` records where it came from (onboarding | consolidation | user | ...).
model Memory {
  id        String     @id @default(cuid())
  orgId     String
  tier      MemoryTier @default(core)
  key       String?
  content   String     @db.Text
  source    String     @default("")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([orgId])
  @@index([orgId, tier])
}

/// Per-org usage plan + bucket (plan Pillar 2 — the usage bucket). No Stripe yet: `bucketMicros` is
/// the included agent-compute per period and `overageOptIn` lets builds continue past it (default
/// true so dogfooding never blocks). Stripe subscription/customer ids slot in here when billing lands.
model Subscription {
  id           String   @id @default(cuid())
  orgId        String   @unique
  plan         String   @default("pro")
  bucketMicros Int      @default(20000000) // included compute/period (~$20 placeholder; tune with pricing)
  overageOptIn Boolean  @default(true)
  periodStart  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId])
}
