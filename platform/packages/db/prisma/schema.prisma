// Prisma schema for Lead Answered — Phase 1 data model (SCOPE §4).
// Vertical-neutral field names; only Sarah's conversation copy is homeowner-flavored.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NumberType {
  toll_free
  local
}

enum VerificationStatus {
  pending
  verified
  failed
}

enum NumberStatus {
  active
  pending_swap
  retired
}

enum LeadStatus {
  new
  contacted
  qualifying
  booked
  disqualified
  no_response
}

enum ConversationState {
  greeting
  qualifying
  proposing_slots
  confirming
  booked
  done
}

enum MessageDirection {
  inbound
  outbound
}

enum AppointmentStatus {
  proposed
  confirmed
  shown
  no_show
  rescheduled
  cancelled
}

enum NotificationEventType {
  booking_confirmed
  booking_rescheduled
  booking_cancelled
  new_qualified_lead
  new_inquiry
  lead_unresponsive
  disqualified_lead
}

enum NotificationChannel {
  sms
  email
  both
}

model Contractor {
  id                   String   @id @default(cuid())
  name                 String
  companyName          String
  // Email-routing key (SCOPE §9): lead emails arrive at leads+{slug}@<domain>.
  slug                 String?  @unique
  projectTypes         String[]
  qualificationRules   Json     @default("{}")
  standingAvailability Json     @default("{}")
  sarahName            String   @default("Sarah")
  sarahPersonaNotes    String?
  // Customer-question topics Sarah loops the contractor in on (dashboard-editable; SCOPE §5.1).
  escalationTopics     String[] @default([])

  // Onboarding (Phase 3): owner login link + whether they've finished self-serve setup.
  ownerEmail         String?  @unique
  onboardingComplete Boolean  @default(false)

  // Structured service area (SCOPE §5.1) — never free-text.
  baseLocations    Json     @default("[]") // [{ zip, radiusMiles }]
  includeOverrides String[] @default([])
  excludeOverrides String[] @default([])

  // Telephony (SCOPE §9.5) — dedicated number per contractor.
  twilioNumber        String?
  messagingServiceSid String?
  numberType          NumberType         @default(toll_free)
  verificationStatus  VerificationStatus @default(pending)
  numberStatus        NumberStatus       @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads               Lead[]
  appointments        Appointment[]
  recipients          NotificationRecipient[]
  escalations         Escalation[]
  calendarConnections CalendarConnection[]
}

model NotificationRecipient {
  id           String  @id @default(cuid())
  contractorId String
  name         String
  phone        String?
  email        String?

  contractor    Contractor                 @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  subscriptions NotificationSubscription[]
}

model NotificationSubscription {
  id          String                @id @default(cuid())
  recipientId String
  eventType   NotificationEventType
  channels    NotificationChannel

  recipient NotificationRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, eventType])
}

model Lead {
  id           String     @id @default(cuid())
  contractorId String
  contactName  String
  contactPhone String
  projectHint  String?
  serviceTown  String?
  serviceZip   String?
  fullAddress  String?
  source       String     @default("manual")
  // Idempotency key for email intake (Postmark MessageID) — a retried inbound
  // with the same id is skipped, never a duplicate lead + duplicate opening text.
  sourceMessageId String?  @unique
  status       LeadStatus @default(new)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  contractor   Contractor    @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  conversation Conversation?
  appointments Appointment[]
  escalations  Escalation[]

  @@index([contractorId, contactPhone])
}

model Conversation {
  id        String            @id @default(cuid())
  leadId    String            @unique
  state     ConversationState @default(greeting)
  gathered  Json              @default("{}") // accumulated extraction working-memory
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  body           String
  providerSid    String?          @unique // Twilio MessageSid — idempotency (SCOPE §7)
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

enum EscalationStatus {
  open
  resolved
  expired
}

model Escalation {
  id             String           @id @default(cuid())
  leadId         String
  contractorId   String
  conversationId String
  question       String
  answer         String?
  status         EscalationStatus @default(open)
  createdAt      DateTime         @default(now())
  resolvedAt     DateTime?

  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId, status])
}

enum AppointmentSyncState {
  local_only
  pending_push
  synced
  push_failed
}

model Appointment {
  id           String            @id @default(cuid())
  leadId       String
  contractorId String
  // Calendar-grade interval. UTC instants stored as timestamp; 60-min default for v1.
  startAt      DateTime
  endAt        DateTime
  timezone     String            @default("UTC")
  status       AppointmentStatus @default(confirmed)

  // Calendar-sync seam — unused until a one-way CalendarSync adapter ships. Our DB is
  // ALWAYS the source of truth; a provider (Google, etc.) is a push target + free/busy
  // source, never the booking authority.
  externalProvider   String?
  externalCalendarId String?
  externalEventId    String?
  syncState          AppointmentSyncState @default(local_only)
  syncedAt           DateTime?

  rescheduledFromIso DateTime? // prior slot, when this booking was moved
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime  @default(now())

  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([leadId, status])
  @@index([contractorId, startAt])
  // NOTE: Booking integrity is enforced by RAW-SQL constraints in the migration that
  // Prisma can't express: a btree_gist EXCLUDE that forbids two overlapping ACTIVE
  // appointments per contractor, plus partial unique indexes (active start-per-contractor;
  // one active per lead). Do NOT `prisma migrate dev` against prod — it would try to drop them.
}

/// Per-contractor calendar provider connection. Empty/unused until calendar sync ships.
model CalendarConnection {
  id                 String    @id @default(cuid())
  contractorId       String
  provider           String // 'google' | …
  externalCalendarId String?
  accessToken        String? // encrypted at rest once sync ships
  refreshToken       String?
  tokenExpiresAt     DateTime?
  status             String    @default("disconnected")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@unique([contractorId, provider])
}
