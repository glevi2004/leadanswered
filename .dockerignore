# Build context = repo root. Keep it lean + secret-free.
**/node_modules
**/.next
**/dist
**/.turbo
.git
.agents
.claude
platform/.agents
platform/landing-page
**/*.log
# Secrets — never copy local env files into the image.
**/.env
**/.env.*
!**/.env.example
# Non-platform repo dirs not needed for the api/worker image
books
brand
clients
delivery
demo
gtm
ops
playbook
sales
tools
